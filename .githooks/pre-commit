#!/usr/bin/env bash
#
# Refuse a commit that lints dirty or breaks a check.
#
# Enable once per clone (git does not track .git/hooks):
#     git config core.hooksPath .githooks
#
# This matters more here than in most repos because the Ralph loop commits
# unattended — nobody is watching to notice a red suite. ralph.sh already stops
# when an implementer pass produces no commit, so a rejection here surfaces as
# the loop halting rather than as a broken commit landing at 3am.
#
# Bypass deliberately with `git commit --no-verify` when you mean to; CI runs
# both of these again, so a bypass buys time, not a pass.

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

command -v uv >/dev/null || { echo "pre-commit: uv not on PATH, skipping" >&2; exit 0; }

printf '\033[1mpre-commit: ruff\033[0m\n'
uv run ruff check . || {
    echo "" >&2
    echo "Lint failed. 'uv run ruff check . --fix' fixes most of it." >&2
    exit 1
}

printf '\033[1mpre-commit: pytest\033[0m\n'
uv run pytest -q || {
    echo "" >&2
    echo "Checks failed. A red commit is a trap for the next iteration." >&2
    exit 1
}
