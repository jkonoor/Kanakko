# Every key the stack needs. Copy to .env for local `docker compose up`; on
# Dokploy the same keys go in `compose.saveEnvironment` (DEPLOYMENT.md step 3).
#
# Values are empty on purpose — this file is committed. A real token here is a
# leaked token. .gitignore already excludes .env and *.env.

# Postgres. The same three values create the database and build DATABASE_URL.
#
# POSTGRES_PASSWORD must be URL-safe: [A-Za-z0-9._~-] only. It is interpolated
# into DATABASE_URL unencoded, so an `@` makes the host `<rest>@db` and web dies
# in the migrator naming DNS while db sits there healthy — a crash loop whose
# error points at everything except the password.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Set this only to run the app or the migrator outside compose. Inside compose
# it is built from the three keys above and this value is ignored.
# DATABASE_URL=postgresql://user:password@localhost:5432/kanakko

# From BotFather. Signs the Mini App's initData too (DECISIONS §13).
TELEGRAM_BOT_TOKEN=

# Telegram's webhook secret_token (DECISIONS §15). Registered on setWebhook,
# arrives in the X-Telegram-Bot-Api-Secret-Token header; /webhook 403s when it
# is absent, wrong, or unset. Required. Alphabet A-Za-z0-9_- only, 1–256 chars.
TELEGRAM_WEBHOOK_SECRET=

# OpenRouter (DECISIONS §2). The model is a config value so switching to a
# cheaper one is an env change, not a deploy; unset means claude-opus-5.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Who may use the bot (DECISIONS §16): `invite` (closed, invite-only) or `open`
# (anyone). Fails closed — unset or anything but the exact word `open` stays
# `invite`, so going public is one deliberate change, never an accident. Leave
# empty here; compose supplies `invite`.
SIGNUP_MODE=

# Who may issue signup invites with /invite_signup (DECISIONS §16) — comma-
# separated Telegram user ids, e.g. `12345678,87654321`. A signup invite admits a
# stranger to the bot, so it is deliberately not a database role: gating it on
# "owns a household" would let every admitted tester admit more. Empty or unset
# admits nobody, and a non-integer entry is skipped rather than crashing.
ADMIN_TELEGRAM_IDS=

# Per-user daily message cap (DECISIONS §16, "Cost control"). Every message is
# one LLM call, so this bounds a runaway user's cost. Optional — leave empty
# here; compose supplies 50, and code falls back to 50 for unset/non-integer.
# Read with `or`, so compose's `:-` empty is fine.
DAILY_MESSAGE_CAP=

# Logging, audit trail, and trace mode (DECISIONS §17). All optional — compose
# supplies defaults, so leave them empty here. LOG_DIR is where the operational
# JSON Lines log and the trace folders live (the mounted volume); unset disables
# both, which is what keeps `uv run pytest` from writing into the repo. TRACE_MODE
# is on unless set to `off`; TRACE_KEEP is the number of update folders to retain
# (unset means 500). Read in code with `or`, so compose's `:-` empty is fine.
LOG_DIR=
TRACE_MODE=
TRACE_KEEP=
