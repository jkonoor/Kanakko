# Every key the stack needs. Copy to .env for local `docker compose up`; on
# Dokploy the same keys go in `compose.saveEnvironment` (DEPLOYMENT.md step 3).
#
# Values are empty on purpose — this file is committed. A real token here is a
# leaked token. .gitignore already excludes .env and *.env.

# Postgres. The same three values create the database and build DATABASE_URL.
#
# POSTGRES_PASSWORD must be URL-safe: [A-Za-z0-9._~-] only. It is interpolated
# into DATABASE_URL unencoded, so an `@` makes the host `<rest>@db` and web dies
# in the migrator naming DNS while db sits there healthy — a crash loop whose
# error points at everything except the password.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Set this only to run the app or the migrator outside compose. Inside compose
# it is built from the three keys above and this value is ignored.
# DATABASE_URL=postgresql://user:password@localhost:5432/kanakko

# From BotFather. Signs the Mini App's initData too (DECISIONS §13).
TELEGRAM_BOT_TOKEN=

# Telegram's webhook secret_token (DECISIONS §15). Registered on setWebhook,
# arrives in the X-Telegram-Bot-Api-Secret-Token header; /webhook 403s when it
# is absent, wrong, or unset. Required. Alphabet A-Za-z0-9_- only, 1–256 chars.
TELEGRAM_WEBHOOK_SECRET=

# OpenRouter (DECISIONS §2). The model is a config value so switching to a
# cheaper one is an env change, not a deploy; unset means claude-opus-5.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
